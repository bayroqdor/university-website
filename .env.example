# University Website — environment variables. Copy with: cp .env.example .env
# docker compose reads .env automatically. For run.sh: set -a; source .env; set +a; ./run.sh

# ---------- Admin account (created on first startup)
SITE_ADMIN_LOGIN=admin
# If left empty, a random password is generated and written to container logs and /data/admin_password.txt
SITE_ADMIN_PASSWORD=
SITE_ADMIN_EMAIL=
# Set to "1" to reset the admin password back to SITE_ADMIN_PASSWORD on every startup
SITE_ADMIN_RESET_PASSWORD=

# ---------- Site
# Public site URL — used for links in emails, sitemap, RSS, and og:image
SITE_URL=https://example.edu
SITE_TZ=Asia/Tashkent
# Set to "1" behind HTTPS (nginx, Cloudflare) so auth cookies carry the Secure flag
SITE_COOKIE_SECURE=1

# ---------- Demo academic data (sample groups, teachers, students, timetable)
# Set to 0 in production; when 1, sample demo accounts are created on first run
SITE_DEMO_ACADEMIC=0
SITE_DEMO_PASSWORD=demo2025

# ---------- Database
# PostgreSQL 12+ only. With docker compose, the "db" service is configured automatically.
# With run.sh, leave empty to initialize a local PostgreSQL cluster in ./var/pg (requires initdb/pg_ctl).
# External PostgreSQL: SITE_DATABASE_URL=postgresql://user:password@host:5432/university
# SITE_DATABASE_URL=
# Connection pool size (default 20)
# SITE_DATABASE_POOL=20
# Legacy SQLite database (SITE_DATA_DIR/site.sqlite3) is migrated once to PostgreSQL on first startup.

# ---------- ONLYOFFICE (in-browser document viewer/editor; automatic with docker compose)
# SITE_OFFICE_ENABLED=1
# For an external Document Server: browser-facing URL and JWT secret
# SITE_OFFICE_URL=https://office.example.edu
# SITE_OFFICE_JWT_SECRET=
# ONLYOFFICE_VERSION=latest

# ---------- Ports
# docker compose external host port (container always listens on 8000)
SITE_PORT=11659
# run.sh local port
PORT=8000

# ---------- Directories (no need to change in Docker)
# Media, documents, library files, backups. Docker: /data (volume). run.sh: ./var
# SITE_DATA_DIR=/data
# Built frontend assets (frontend/dist)
# SITE_STATIC_DIR=/app/frontend/dist

# ---------- PDF & og:image rendering (headless Chromium)
# Max concurrent Chromium instances (~150 MB RAM each)
SITE_RENDER_CONCURRENCY=2
# Set to "0" to disable Chromium prewarming at startup (saves RAM; first PDF renders slower)
SITE_PREWARM=1
# Custom Chromium binary path (when Playwright is not installed)
# SITE_CHROMIUM_PATH=/usr/bin/chromium
# Internal base URL used by headless Chromium when behind a reverse proxy
# SITE_INTERNAL_URL=http://127.0.0.1:8000

# ---------- Built-in Mail (login@domain mailbox for staff and students, Webmail tab in portal)
# docker compose up starts and auto-configures Stalwart Mail Server (domain, DKIM, admin password, mailboxes).
# To disable mail completely: SITE_MAIL_ENABLED=0
SITE_MAIL_ENABLED=
SITE_MAIL_DOMAIN=example.edu
MAIL_HOSTNAME=mail.example.edu
# Set to "1" for Let's Encrypt TLS certificate (mail.example.edu DNS must point to this host); "0" for self-signed
MAIL_ACME=0
# Host ports
MAIL_SMTP_PORT=25
MAIL_SUBMISSION_PORT=465
MAIL_IMAP_PORT=993
# Stalwart admin UI port (localhost only by default)
MAIL_ADMIN_PORT=127.0.0.1:8081
# Connection details shown to users for mobile/desktop mail clients (Thunderbird, etc.)
SITE_MAIL_PUBLIC_IMAP=mail.example.edu:993 (SSL)
SITE_MAIL_PUBLIC_SMTP=mail.example.edu:465 (SSL)
# Max attachment size (MB) and default mailbox quota (MB, 0 = unlimited)
SITE_MAIL_MAX_ATTACH_MB=20
SITE_MAIL_QUOTA_MB=0
# --- External mail server overrides (manual):
# SITE_MAIL_IMAP_HOST=mail
# SITE_MAIL_SMTP_HOST=mail
# SITE_MAIL_STALWART_PASSWORD=
# SITE_MAIL_MASTER_PASSWORD=
# SITE_MAIL_PROVISION=none
# SITE_MAIL_LOGIN_FORMAT={address}*{master}

# ---------------------------------------------------------------- HEMIS integration (also configurable in Admin -> HEMIS)
# SITE_HEMIS_ENABLED=0
# SITE_HEMIS_API_URL=https://student.example.edu
# SITE_HEMIS_TOKEN=
# SITE_HEMIS_URL=https://student.example.edu
# SITE_HEMIS_AUTO_HOURS=0

# ---------------------------------------------------------------- S3 object storage (also configurable in Admin -> Storage)
# SITE_S3_ENABLED=0
# SITE_S3_ENDPOINT=https://s3.amazonaws.com
# SITE_S3_REGION=us-east-1
# SITE_S3_BUCKET=
# SITE_S3_ACCESS_KEY=
# SITE_S3_SECRET_KEY=
# SITE_S3_PREFIX=university/
# SITE_S3_PUBLIC_URL=
# SITE_S3_PATH_STYLE=1
# SITE_S3_KEEP_LOCAL=0

# ---------------------------------------------------------------- Telegram bot (also configurable in Admin -> Telegram Bot)
# SITE_TELEGRAM_TOKEN=
# "polling" works on any server; "webhook" requires public HTTPS
# SITE_TELEGRAM_MODE=polling

# ---------------------------------------------------------------- Auto-setup
# Installs missing Python packages, YuNet face-detection model, and Chromium on startup. Set to 0 to disable.
# SITE_AUTO_SETUP=1
